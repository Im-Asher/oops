# 复制为 .env.local 并填入真实值。.env* 已被 gitignore，.env.example 除外。

# PostgreSQL（与 docker-compose.yaml 对应）
DATABASE_URL=postgresql://oops:oops@localhost:5432/oops

# S3 兼容对象存储（本地 dev 走 docker-compose 的 MinIO；切换云上后端只改以下变量）
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=oops-assets
# path-style 寻址：MinIO / Supabase 保持默认 true；阿里云 OSS / 腾讯云 COS 为虚拟域名风格，设 false
S3_FORCE_PATH_STYLE=true
# ---- 云后端对照速查 ----
# Supabase：  S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3  S3_REGION=<项目 region>
# 阿里云 OSS：S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com  S3_REGION=cn-hangzhou
#             （签名 region 不带 oss- 前缀！endpoint 是 oss-cn-*，region 是 cn-*）
# 腾讯云 COS：S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com  S3_REGION=ap-guangzhou
#             S3_BUCKET=<bucket>-<appid>（bucket 名必须带 APPID 后缀）

# 阿里云百炼 Token Plan（China 端点），pi-ai 内置 provider 读取
QWEN_TOKEN_PLAN_CN_API_KEY=sk-sp-在此填入你的key

# 认证延后期间的固定用户标识（多租户预留）
OWNER_ID=owner

# 会话 cookie 签名密钥（必填，至少 32 字符；生成：openssl rand -base64 32）
# 轮换该密钥 = 所有用户会话立即失效
AUTH_SECRET=在此填入 openssl rand -base64 32 的输出
