# 复制为 .env.local 并填入真实值。.env* 已被 gitignore，.env.example 除外。

# PostgreSQL（与 docker-compose.yaml 对应）
DATABASE_URL=postgresql://oops:oops@localhost:5432/oops

# S3 兼容对象存储（本地 dev 走 docker-compose 的 MinIO；切换云上后端只改以下变量）
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=oops-assets
# path-style 寻址：MinIO / Supabase 保持默认 true；阿里云 OSS / 腾讯云 COS 为虚拟域名风格，设 false
S3_FORCE_PATH_STYLE=true
# ---- 云后端对照速查 ----
# Supabase：  S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3  S3_REGION=<项目 region>
# 阿里云 OSS：S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com  S3_REGION=cn-hangzhou
#             （签名 region 不带 oss- 前缀！endpoint 是 oss-cn-*，region 是 cn-*）
# 腾讯云 COS：S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com  S3_REGION=ap-guangzhou
#             S3_BUCKET=<bucket>-<appid>（bucket 名必须带 APPID 后缀）

# 阿里云百炼 Token Plan（China 端点），pi-ai 内置 provider 读取
QWEN_TOKEN_PLAN_CN_API_KEY=sk-sp-在此填入你的key

# ---- LLM 装配（src/server/llm/catalog.ts 目录登记）----
# 文本域供应商声明：填目录登记的 providerId，缺省 qwen-token-plan-cn 保持现状。
# 切换供应商 = 改此项 + 配置该供应商在目录中登记的 key env，不改代码。
# LLM_PROVIDER=qwen-token-plan-cn
# 角色级模型覆盖（值为目录登记的模型 id；未设置走目录默认，main 与 summarizer 默认同模型）
# LLM_MAIN_MODEL=qwen3.8-max
# LLM_SUMMARIZER_MODEL=qwen3.8-max
# 海报 Agent（poster-designer）声明 vision 能力：需将主模型指向已登记的
# vision 模型（qwen3.7-plus，须为 provider 模型数据中真实存在的 id）。
# 未配置时其他 Agent 零影响，海报回合显式报错。
# LLM_MAIN_MODEL=qwen3.7-plus

# ---- HTML 渲染沙箱（海报 Agent）----
# 出网白名单 host（逗号分隔；默认空 = 仅内联资源，图片由渲染前内联为 data URI）
# RENDER_ALLOWED_HOSTS=
# 单次渲染超时（毫秒）
# RENDER_TIMEOUT_MS=30000
# Chromium 可执行路径（未设走 playwright 默认解析；首次部署需 `pnpm dlx playwright install chromium`）
# RENDER_EXECUTABLE_PATH=/usr/bin/chromium

# 认证延后期间的固定用户标识（多租户预留）
OWNER_ID=owner

# 会话 cookie 签名密钥（必填，至少 32 字符；生成：openssl rand -base64 32）
# 轮换该密钥 = 所有用户会话立即失效
AUTH_SECRET=在此填入 openssl rand -base64 32 的输出
